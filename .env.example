# Copy thành .env rồi chỉnh nếu cần. Các giá trị dưới là mặc định cho môi trường local.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamfilm
S3_SECRET_KEY=streamfilm-secret
S3_BUCKET_RAW=raw
S3_BUCKET_HLS=hls
CDN_BASE_URL=http://localhost:8088
POSTGRES_PASSWORD=streamfilm
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# M2: api + transcoder worker khi chạy trên host (make run-api / make run-worker).
# Trong docker compose các giá trị này được đặt riêng trong deploy/docker-compose.yml.
S3_PUBLIC_ENDPOINT=http://localhost:9000
DATABASE_URL=postgres://streamfilm:streamfilm@localhost:5432/streamfilm?sslmode=disable
KAFKA_BROKERS=localhost:29092
HTTP_ADDR=:8000
STALE_UPLOAD_AFTER=24h
CLEANUP_INTERVAL=1h

# M3: auth + signed URL. Giá trị dưới chỉ dùng cho local; đổi khi chạy ở nơi khác.
# JWT_SECRET >= 32 ký tự. CDN_SIGNING_SECRET 16-128 ký tự [A-Za-z0-9_-], dùng chung cho api và nginx.
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
CDN_SIGNING_SECRET=dev-cdn-secret-change-me
COOKIE_SECURE=false
# Tài khoản admin mà `make seed-admin` tạo và script e2e dùng để đăng nhập.
ADMIN_EMAIL=admin@streamfilm.local
ADMIN_PASSWORD=admin-dev-password

# M6: analytics (make run-analytics) và make analytics-sql đọc ClickHouse qua HTTP. Mật khẩu phải bằng
# POSTGRES_PASSWORD (compose đặt CLICKHOUSE_PASSWORD của service clickhouse từ biến đó).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=streamfilm
CLICKHOUSE_USER=streamfilm
CLICKHOUSE_PASSWORD=streamfilm

# M7: origin được phép PUT part upload từ trình duyệt lên MinIO (CORS, phân tách bằng dấu phẩy). Phải chứa origin
# mở trang admin (CDN_BASE_URL) và Vite dev server. Đổi rồi chạy lại make up để MinIO nhận giá trị mới.
MINIO_CORS_ALLOW_ORIGIN=http://localhost:8088,http://localhost:5173
